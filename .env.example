# VITE_INSIGHTS_WORKER_URL: Public URL of the Cloudflare Worker that proxies Groq API calls.
# The Groq API key lives inside the Worker as a secret — it never appears here.
# For local dev: copy this file to .env.local and fill in your worker URL.
# For GitHub Pages: set this as a GitHub repo variable (Settings → Secrets and variables → Variables).
VITE_INSIGHTS_WORKER_URL="https://urban-climate-insights.tomi.workers.dev"
